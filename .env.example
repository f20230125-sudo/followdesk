# Settings are read from the process; this file is not silently loaded.
FOLLOWDESK_PORT=5059
FOLLOWDESK_LOOPDESK_URL=http://127.0.0.1:5055
# Local use requires Node.js for its built-in AES-256-GCM token vault.
# Hosted use requires PostgreSQL, an HTTPS CRM URL, explicit hosts, a random
# session secret and a Fernet vault key. Cryptography is pinned in requirements.txt.
# FOLLOWDESK_DATABASE_URL=postgresql://...
# FOLLOWDESK_SECRET_KEY=
# FOLLOWDESK_VAULT_KEY=
# FOLLOWDESK_TRUSTED_HOSTS=
# APP_ENV=production
